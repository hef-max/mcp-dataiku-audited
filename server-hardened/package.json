{
  "name": "@adi-internal/mcp-dataiku-hardened",
  "version": "0.1.0",
  "description": "Auditable, dependency-minimized MCP server for Dataiku DSS",
  "type": "module",
  "main": "dist/mcp-server.js",
  "bin": {
    "mcp-dataiku": "dist/mcp-server.js"
  },
  "files": [
    "dist/**/*",
    "src/**/*",
    "README.md",
    "SECURITY.md",
    "UPSTREAM.md",
    "sbom.cdx.json",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/mcp-server.js",
    "check": "tsc --noEmit",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "prepack": "npm run check && npm run build",
    "lint": "eslint src",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "keywords": [
    "mcp",
    "dataiku",
    "dss",
    "data-science",
    "etl",
    "server",
    "model-context-protocol"
  ],
  "author": "PT All Data International",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.15.30",
    "eslint": "9.39.5",
    "typescript": "5.8.3",
    "typescript-eslint": "8.70.1"
  },
  "private": true
}
